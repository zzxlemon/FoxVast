# flog demo - run from anywhere: fox -f demo.fox
!import flog

func main() -> void {
    # 1) default config, console only, everything from debug up
    c = flog.flog_default_config()
    flog.flog_debug(c, "starting up")
    flog.flog_info(c, "config loaded")

    # 2) raise the level to warn: debug/info are suppressed
    c2 = flog.flog_set_level(c, 2)
    flog.flog_debug(c2, "you never see this")
    flog.flog_info(c2, "nor this")
    flog.flog_warn(c2, "this one shows")

    # 3) custom format + module name
    c3 = flog.flog_set_format(c2, "[{time}] [{level}] <{name}> {msg}")
    c3 = flog.flog_set_name(c3, "game")
    flog.flog_error(c3, "connection lost")

    # 4) plain time formats / strftime customisation
    c4 = flog.flog_set_time_fmt(c3, "%H:%M:%S")
    flog.flog_warn(c4, "time-only format")

    # 5) log to a file as well
    c5 = flog.flog_set_output(c3, "both")
    c5 = flog.flog_set_path(c5, "demo.log")
    flog.flog_warn(c5, "written to console AND file")

    # 6) ANSI colors on the console (file output stays plain)
    c6 = flog.flog_set_color(c5, 1)
    c6 = flog.flog_set_format(c6, "{color}{time} [{level}] <{name}> {msg}{reset}")
    flog.flog_debug(c6, "debug is grey")
    flog.flog_info(c6, "info is green")
    flog.flog_warn(c6, "warn is yellow")
    flog.flog_error(c6, "error is red")
    flog.flog_fatal(c6, "fatal is magenta")

    # 6b) custom per-level color + highlight a substring of the message.
    #     back to level 0 so every color shows; console-only so demo.log
    #     stays free of ANSI codes (see README note 2).
    c7 = flog.flog_set_color_code(c6, 1, 94)
    c7 = flog.flog_set_level(c7, 0)
    c7 = flog.flog_set_output(c7, "console")
    flog.flog_info(c7, "info now bright blue")
    hl = flog.flog_highlight(c7, "warning: disk is 92% full", 17, 19, 33)
    flog.flog_warn(c7, hl)

    # 7) write one line straight to a file without changing the config
    flog.flog_log_to(c, 1, "audit trail entry", "audit.log")

    # 8) render a line yourself and use it anywhere
    line = flog.flog_render_line(c, 3, "custom consumer")
    println("DIY: " + line)

    println("done")
}
