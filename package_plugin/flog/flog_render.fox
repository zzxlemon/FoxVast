# flog_render.fox - turn (config, level, message) into a formatted line.
import fox.std.util
import fox.sys.time
#
# Supported placeholders in config.format:
#   {time}       current local time, shaped by config.time_fmt (strftime)
#   {level}      level name, upper case (DEBUG/INFO/WARN/ERROR/FATAL)
#   {level_num}  level as a number 0..4
#   {name}       module/tag from config.name ("" prints nothing)
#   {msg}        the message text
#   {nl}         a newline (for multi-part templates)
#   {esc_q}      a double quote character (handy when quoting log lines)
#   {color}      ANSI color code for the current level, "" when color=0
#                (debug=grey, info=green, warn=yellow, error=red, fatal=magenta)
#   {reset}      ANSI reset code, "" when color=0
#
# Unknown placeholders are left untouched, so you can mix in your own tokens
# and replace them afterwards with util.str_replace if you like.
#
# The str_replace chain runs longest tokens first ({level_num} before {level},
# {esc_q} before {msg}) to avoid partial-token corruption.

# ANSI SGR code per level, taken from config.color_map (user-overridable).
# Defaults: 0 grey, 1 green, 2 yellow, 3 red, 4 magenta.
func _flog_color_code(c <- dict, l <- int) -> int {
    ret c["color_map"][util.IntChangeString(l)]
}

# Wrap the characters from a (inclusive) to b (inclusive) of msg in the given
# ANSI SGR code. Positions are 0-based and match util.str_substring offsets
# (str_substring takes an exclusive end, so b is included here explicitly).
# Returns the original message unchanged when the range is empty/out of bounds.
func flog_highlight(c <- dict, msg <- string, a <- int, b <- int, code <- int) -> string {
    len = util.str_length(msg)
    if (a < 0) { a = 0 }
    if (b >= len) { b = len - 1 }
    if (a > b) { ret msg }
    before = util.str_substring(msg, 0, a)
    mid = util.str_substring(msg, a, b + 1)
    after = util.str_substring(msg, b + 1, len)
    ret before + "\e[" + util.IntChangeString(code) + "m" + mid + "\e[0m" + after
}

func flog_render(c <- dict, l <- int, msg <- string) -> string {
    line = c["format"]
    line = util.str_replace(line, "{time}", time.format(c["time_fmt"]))
    line = util.str_replace(line, "{level_num}", util.IntChangeString(l))
    line = util.str_replace(line, "{level}", flog_level_name(l))
    line = util.str_replace(line, "{name}", c["name"])
    line = util.str_replace(line, "{nl}", "\n")
    line = util.str_replace(line, "{esc_q}", "\"")
    if (c["color"] == 1) {
        line = util.str_replace(line, "{color}", "\e[" + util.IntChangeString(_flog_color_code(c, l)) + "m")
        line = util.str_replace(line, "{reset}", "\e[0m")
    } else {
        line = util.str_replace(line, "{color}", "")
        line = util.str_replace(line, "{reset}", "")
    }
    line = util.str_replace(line, "{msg}", msg)
    ret line
}

# Plain rendering: color placeholders always become "" so log files stay
# clean text. Used for every file output regardless of the color setting.
func flog_render_plain(c <- dict, l <- int, msg <- string) -> string {
    line = c["format"]
    line = util.str_replace(line, "{time}", time.format(c["time_fmt"]))
    line = util.str_replace(line, "{level_num}", util.IntChangeString(l))
    line = util.str_replace(line, "{level}", flog_level_name(l))
    line = util.str_replace(line, "{name}", c["name"])
    line = util.str_replace(line, "{nl}", "\n")
    line = util.str_replace(line, "{esc_q}", "\"")
    line = util.str_replace(line, "{color}", "")
    line = util.str_replace(line, "{reset}", "")
    line = util.str_replace(line, "{msg}", msg)
    ret line
}
