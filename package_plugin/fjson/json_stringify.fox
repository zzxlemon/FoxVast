import fox.std.util
func _s_str(s_s <- string) -> string {
    nss = util.str_length(s_s)
    ost = ""
    iss = 0
    while (iss < nss) {
        css = util.str_substring(s_s, iss, iss + 1)
        if (css == "\"") { ost = ost + "\\\"" }
        else {
            if (css == "\\") { ost = ost + "\\\\" }
            else {
                if (css == "\n") { ost = ost + "\\n" }
                else {
                    if (css == "\r") { ost = ost + "\\r" }
                    else {
                        if (css == "\t") { ost = ost + "\\t" }
                        else {
                            if (css == "\b") { ost = ost + "\\b" }
                            else {
                                if (css == "\f") { ost = ost + "\\f" }
                                else { ost = ost + css }
                            }
                        }
                    }
                }
            }
        }
        iss = iss + 1
    }
    ret ost
}
func _s_num(nd_m <- dict) -> string {
    ret nd_m["s"]
}
func _s_obj(nd_o <- dict) -> string {
    vo = nd_o["v"]
    ret fjson._s_obj_loop(vo["keys"], vo["vals"], 0, "{")
}
func _s_obj_loop(ks_l <- dict, vl_l <- dict, i_l <- int, ot_l <- string) -> string {
    lso = util.arr_length(ks_l)
    if (i_l >= lso) { ret ot_l + "}" }
    kko = ks_l[i_l]
    if (i_l > 0) {
        ret fjson._s_obj_loop(ks_l, vl_l, i_l + 1, ot_l + "," + "\"" + fjson._s_str(kko) + "\":" + fjson.stringify(vl_l[kko]))
    }
    ret fjson._s_obj_loop(ks_l, vl_l, i_l + 1, ot_l + "\"" + fjson._s_str(kko) + "\":" + fjson.stringify(vl_l[kko]))
}
func _s_arr(nd_r <- dict) -> string {
    ret fjson._s_arr_loop(nd_r["v"], 0, "[")
}
func _s_arr_loop(v_r <- dict, i_r <- int, ot_r <- string) -> string {
    lsa = util.arr_length(v_r)
    if (i_r >= lsa) { ret ot_r + "]" }
    vva = v_r[i_r]
    if (i_r > 0) {
        ret fjson._s_arr_loop(v_r, i_r + 1, ot_r + "," + fjson.stringify(vva))
    }
    ret fjson._s_arr_loop(v_r, i_r + 1, ot_r + fjson.stringify(vva))
}
func stringify(nd_sf <- dict) -> string {
    ts = nd_sf["t"]
    if (ts == "obj") { ret fjson._s_obj(nd_sf) }
    if (ts == "arr") { ret fjson._s_arr(nd_sf) }
    if (ts == "str") {
        svs = {"r": fjson._s_str(nd_sf["v"])}["r"]
        ret "\"" + svs + "\""
    }
    if (ts == "num") { ret fjson._s_num(nd_sf) }
    if (ts == "bool") {
        if (nd_sf["v"] == 1) { ret "true" }
        ret "false"
    }
    if (ts == "null") { ret "null" }
    error("fjson: bad node type in stringify")
}
