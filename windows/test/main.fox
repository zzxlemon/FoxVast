!import fjson
!import flog
import fox.std.util
import fox.sys.io.fs

func main() -> void {
    c = flog.flog_default_config()

    h = file.file_open("../../test/test.json", "read")
    txt = file.file_read(h)
    file.file_close(h) 
    
    flog.flog_info(c, "'test.json' content: " + txt)

    n = fjson.parse(txt) 
    flog.flog_info(c, "name: " + fjson.str_val(fjson.get(n, "name")))
    flog.flog_info(c, "publisher: " + fjson.str_val(fjson.get(n, "publisher")))
    flog.flog_info(c, "version: " + fjson.str_val(fjson.get(n, "version")))
    flog.flog_info(c, "description: " + fjson.str_val(fjson.get(n, "description")))

    two(c)
}

func two(c <- dict) -> void{
    a = 100
    flog.flog_info(c, util.IntChangeString(a))
    a += 10
    flog.flog_info(c, util.IntChangeString(a))
}
