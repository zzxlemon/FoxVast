func main() -> void {
    ok = 1

    d = {"a": 1, "b": 2}
    if (d["a"] != 1 or d["b"] != 2) {
        ok = 0
    }

    inner = {"x": 10, "y": {"z": 99}}
    d["inner"] = inner
    if (d["inner"]["x"] != 10 or d["inner"]["y"]["z"] != 99) {
        ok = 0
    }

    i = 0
    while (i < 200000) {
        t = {"v": i, "n": {"k": i * 2}}
        t["v"] = t["v"] + 1
        i = i + 1
    }
    if (i != 200000) {
        ok = 0
    }

    cyc = {}
    cyc["self"] = cyc
    if (cyc["self"]["self"]["self"] == cyc) {
        ok = ok
    } else {
        ok = 0
    }

    dd = {"deep": cyc}
    dd["self"] = dd
    if (dd["self"]["deep"]["self"]["self"] == cyc) {
        ok = ok
    } else {
        ok = 0
    }

    if (ok == 1) {
        println("GC OK")
    } else {
        println("GC FAIL")
    }
    exit(0)
}