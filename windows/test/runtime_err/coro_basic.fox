func task(id <- int) -> void {
    n = 0
    while (n < 5) {
        println(n + 10 * id)
        yield(n + 100 * id)
        n = n + 1
    }
}

func producer() -> int {
    p = 0
    while (p < 4) {
        println(2000 + p)
        yield(3000 + p)
        p = p + 1
    }
    ret 9999
}

func main() -> void {
    c1 = co.create("task", 1)
    c2 = co.create("task", 2)
    if (co.status(c1) != "suspended") {
        println("STATUS FAIL 1")
        exit(1)
    }
    y1 = co.resume(c1)
    if (y1 != 100) {
        println("YIELD FAIL 1")
        exit(1)
    }
    y2 = co.resume(c2)
    if (y2 != 200) {
        println("YIELD FAIL 2")
        exit(1)
    }
    y3 = co.resume(c1)
    if (y3 != 101) {
        println("YIELD FAIL 3")
        exit(1)
    }
    n = 0
    while (n < 2) {
        co.resume(c1)
        co.resume(c2)
        n = n + 1
    }
    co.resume(c1)
    co.resume(c2)
    co.resume(c1)
    if (co.status(c1) != "dead") {
        println("STATUS FAIL 2")
        exit(1)
    }
    p1 = co.create("producer")
    it = 0
    while (it < 4) {
        v = co.resume(p1)
        if (v != 3000 + it) {
            println("PROD FAIL")
            exit(1)
        }
        it = it + 1
    }
    if (co.status(p1) != "suspended") {
        println("STATUS FAIL 3")
        exit(1)
    }
    rv = co.resume(p1)
    if (rv != 9999) {
        println("RESULT FAIL")
        exit(1)
    }
    if (co.status(p1) != "dead") {
        println("STATUS FAIL 4")
        exit(1)
    }
    if (co.result(p1) != 9999) {
        println("CO RESULT FAIL")
        exit(1)
    }
    println("CORO OK")
    exit(0)
}