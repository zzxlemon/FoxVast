func main() -> void {
    ok = 1
    i = 0
    while (i < 200000) {
        t = {"v": i, "n": {"k": i * 2}}
        x = t["v"] + t["n"]["k"]
        if (x != i * 3) {
            ok = 0
        }
        i = i + 1
    }
    if (ok == 1) {
        println("LOOP OK")
    } else {
        println("LOOP FAIL")
    }
    d = {"a": 1, "b": {"c": 2}}
    if (d["a"] != 1 or d["b"]["c"] != 2) {
        println("DICT FAIL")
    } else {
        println("DICT OK")
    }
    exit(0)
}