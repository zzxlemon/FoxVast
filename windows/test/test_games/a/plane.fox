import fox.gl.fg -> fg
import fox.std.util -> util
import fox.std.random -> r

func main() -> void {
    win = fg.create_window("FoxPlane - dodge bars", 800, 600)
    fg.set_scale(win, 800, 600)

    px = 360.0
    py = 280.0
    pSpeed = 300.0
    bars = []
    barTimer = 0.0
    score = 0
    over = 0
    font = "NotoSansSC-VariableFont_wght.ttf"

    while (1) {
        if (fg.window_should_close(win) == 1) { break }
        if (fg.key_down(win, "escape") == 1) { break }

        dt = fg.frame_time(win)
        if (dt > 0.05) { dt = 0.05 }

        # ---------- update ----------
        if (over == 0) {
            if (fg.key_down(win, "w") == 1) { py = py - pSpeed * dt }
            if (fg.key_down(win, "s") == 1) { py = py + pSpeed * dt }
            if (py < 0.0) { py = 0.0 }
            if (py > 556.0) { py = 556.0 }

            # spawn a bar every 0.7s
            barTimer = barTimer + dt
            if (barTimer >= 0.7) {
                barTimer = 0.0
                by = r.random("int", 0, 560)
                blen = r.random("int", 60, 150)
                spd = r.random("int", 150, 330)
                col = r.random("int", 0, 5)
                c0 = 0.9
                c1 = 0.9
                c2 = 0.9
                if (col == 0) { c0 = 1.0 }
                if (col == 0) { c1 = 0.3 }
                if (col == 0) { c2 = 0.3 }
                if (col == 1) { c0 = 1.0 }
                if (col == 1) { c1 = 0.65 }
                if (col == 1) { c2 = 0.2 }
                if (col == 2) { c0 = 0.4 }
                if (col == 2) { c1 = 1.0 }
                if (col == 2) { c2 = 0.3 }
                if (col == 3) { c0 = 0.3 }
                if (col == 3) { c1 = 0.9 }
                if (col == 3) { c2 = 1.0 }
                if (col == 4) { c0 = 0.75 }
                if (col == 4) { c1 = 0.45 }
                if (col == 4) { c2 = 1.0 }
                if (col == 5) { c0 = 1.0 }
                if (col == 5) { c1 = 1.0 }
                if (col == 5) { c2 = 1.0 }
                bars = util.arr_append(bars, [-100.0, by * 1.0, blen * 1.0, spd * 1.0, c0, c1, c2])
            }

            # move bars, remove off-screen ones, check collision
            # bar layout: [x, y, len, speed, r, g, b]
            nb = []
            i = 0
            while (i < util.arr_length(bars)) {
                b = bars[i]
                b[0] = b[0] + b[3] * dt
                if (b[0] <= 840.0) {
                    nb = util.arr_append(nb, b)
                    if (px < b[0] + b[2] and px + 40.0 > b[0] and py < b[1] + 24.0 and py + 44.0 > b[1]) {
                        over = 1
                    }
                } else {
                    score = score + 1
                }
                i = i + 1
            }
            bars = nb
        } else {
            if (fg.key_pressed(win, "r") == 1) {
                px = 360.0
                py = 280.0
                bars = []
                barTimer = 0.0
                score = 0
                over = 0
            }
        }

        # ---------- draw ----------
        fg.clear_color(0.05, 0.07, 0.12, 1.0)
        fg.clear()

        # incoming bars
        i = 0
        while (i < util.arr_length(bars)) {
            b = bars[i]
            fg.draw_rect([b[0], b[1], b[4], b[5], b[6]], [b[0] + b[2], b[1], b[4], b[5], b[6]], [b[0] + b[2], b[1] + 24.0, b[4], b[5], b[6]], [b[0], b[1] + 24.0, b[4], b[5], b[6]])
            i = i + 1
        }

        # player plane (faces left, toward the incoming bars) - hitbox [px, py, 40, 44]
        fg.draw_triangle(px - 16.0, py + 8.0, 0.35, 0.75, 1.0, px - 16.0, py + 36.0, 0.35, 0.75, 1.0, px + 2.0, py + 22.0, 0.9, 0.95, 1.0)
        fg.draw_rect([px - 10.0, py, 0.3, 0.6, 0.95], [px + 22.0, py, 0.3, 0.6, 0.95], [px + 22.0, py + 44.0, 0.3, 0.6, 0.95], [px - 10.0, py + 44.0, 0.3, 0.6, 0.95])

        # HUD
        fg.draw_text(font, "SCORE " + util.IntChangeString(score) + "   W/S move, ESC quit", 20, 20, 22, 1.0, 1.0, 1.0)

        if (over == 1) {
            fg.draw_text(font, "GAME OVER", 290, 240, 44, 1.0, 0.3, 0.3)
            fg.draw_text(font, "score " + util.IntChangeString(score) + "  -  press R to restart", 260, 300, 22, 1.0, 0.9, 0.5)
        }

        fg.update(win)
    }

    fg.close()
    println("plane done - score " + util.IntChangeString(score))
}