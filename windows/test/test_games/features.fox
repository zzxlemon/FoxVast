import fox.std.util -> u

func make_dict() -> dict {
    ret {"a": 1, "b": 2}
}

func main() -> void {
    ok = 1

    if (6 * 7 != 42 or
        20 / 4 != 5 or 7 % 3 != 1) {
        ok = 0
    }

    if (1 == 2) {
        ok = 0
    } else {
        ok = ok
    }

    sum = 0
    i = 0
    while (i < 10) {
        i = i + 1
        if (i % 2 == 0) {
            continue
        }
        if (i > 7) {
            break
        }
        sum = sum + i
    }
    if (sum != 16) {
        ok = 0
    }

    arr = [3, 1, 2]
    arr = u.arr_append(arr, 4)
    if (u.arr_contains(arr, 4) != 1 or u.arr_length(arr) != 4) {
        ok = 0
    }
    arr = u.arr_pop(arr)
    arr = u.arr_sort(arr)
    if (u.arr_length(arr) != 3 or arr[0] != 1 or arr[2] != 3) {
        ok = 0
    }
    sliced = u.arr_slice(arr, 1, 3)
    if (u.arr_length(sliced) != 2 or sliced[0] != 2) {
        ok = 0
    }

    if (u.str_contains("foxvast", "fox") != 1 or u.str_replace("a-b-c", "-", "+") != "a+b+c" or u.str_trim("  hi  ") != "hi" or u.str_lower("ABC") != "abc" or u.str_upper("abc") != "ABC" or u.str_substring("foxvast", 0, 3) != "fox" or u.str_length("fox") != 3) {
        ok = 0
    }
    parts = u.str_split("a,b,c", ",")
    if (u.arr_length(parts) != 3 or parts[2] != "c") {
        ok = 0
    }

    d = {"name": "fox", "count": 3}
    if (d["name"] != "fox" or d["count"] != 3) {
        ok = 0
    }
    d["count"] = 5
    if (d["count"] != 5 or u.length(d) != 2) {
        ok = 0
    }
    if (d == {"name": "fox", "count": 5}) {
        ok = ok
    } else {
        ok = 0
    }
    dd = make_dict()
    if (dd["a"] != 1 or dd["b"] != 2) {
        ok = 0
    }

    msg = ""
    try {
        error("boom")
    }
    catch (e) {
        msg = e
    }
    if (msg != "boom") {
        ok = 0
    }

    if (ok == 1) {
        println("FEATURES OK")
    } else {
        println("FEATURES FAIL")
    }
    exit(0)
}
