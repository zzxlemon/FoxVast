import fox.std.util
func _skip_ws(t_ws <- string, i_ws <- int) -> int {
    nw = util.str_length(t_ws)
    while (i_ws < nw) {
        cw = util.str_substring(t_ws, i_ws, i_ws + 1)
        if (cw == " ") { i_ws = i_ws + 1 }
        else {
            if (cw == "\t") { i_ws = i_ws + 1 }
            else {
                if (cw == "\n") { i_ws = i_ws + 1 }
                else {
                    if (cw == "\r") { i_ws = i_ws + 1 }
                    else { ret i_ws }
                }
            }
        }
    }
    ret i_ws
}
func _string(t_st <- string, i_st <- int) -> dict {
    js = i_st + 1
    st = ""
    ns = util.str_length(t_st)
    while (js < ns) {
        cs = util.str_substring(t_st, js, js + 1)
        if (cs == "\"") {
            js = js + 1
            ret {"v": {"t": "str", "v": st}, "pos": js}
        }
        if (cs == "\\") {
            es = util.str_substring(t_st, js + 1, js + 2)
            if (es == "n") { st = st + "\n"; js = js + 2 }
            else {
                if (es == "r") { st = st + "\r"; js = js + 2 }
                else {
                    if (es == "t") { st = st + "\t"; js = js + 2 }
                    else {
                        if (es == "b") { st = st + "\b"; js = js + 2 }
                        else {
                            if (es == "f") { st = st + "\f"; js = js + 2 }
                            else {
                                if (es == "\"") { st = st + "\""; js = js + 2 }
                                else {
                                    if (es == "\\") { st = st + "\\"; js = js + 2 }
                                    else {
                                        if (es == "/") { st = st + "/"; js = js + 2 }
                                        else {
                                            if (es == "u") { st = st + util.str_substring(t_st, js, js + 6); js = js + 6 }
                                            else { error("fjson: bad escape sequence") }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        else {
            st = st + cs
            js = js + 1
        }
    }
    error("fjson: unterminated string")
}
func _number(t_n <- string, i_n <- int) -> dict {
    nn = util.str_length(t_n)
    jn = i_n
    while (jn < nn) {
        cn = util.str_substring(t_n, jn, jn + 1)
        okn = 0
        if (cn == "0") { okn = 1 }
        if (cn == "1") { okn = 1 }
        if (cn == "2") { okn = 1 }
        if (cn == "3") { okn = 1 }
        if (cn == "4") { okn = 1 }
        if (cn == "5") { okn = 1 }
        if (cn == "6") { okn = 1 }
        if (cn == "7") { okn = 1 }
        if (cn == "8") { okn = 1 }
        if (cn == "9") { okn = 1 }
        if (cn == ".") { okn = 1 }
        if (cn == "e") { okn = 1 }
        if (cn == "E") { okn = 1 }
        if (cn == "+") { okn = 1 }
        if (cn == "-") { okn = 1 }
        if (okn == 1) { jn = jn + 1 }
        else { break }
    }
    tk = util.str_substring(t_n, i_n, jn)
    tl = util.str_length(tk)
    if (tl == 0) { error("fjson: empty number") }
    if (tk == "-") { error("fjson: bad number") }
    if (tk == ".") { error("fjson: bad number") }
    if (tk == "+") { error("fjson: bad number") }
    if (tk == "-.") { error("fjson: bad number") }
    ls = util.str_substring(tk, tl - 1, tl)
    if (ls == "e") { error("fjson: bad number") }
    if (ls == "E") { error("fjson: bad number") }
    if (ls == "+") { error("fjson: bad number") }
    if (ls == "-") { error("fjson: bad number") }
    idn = 0
    if (util.str_contains(tk, ".") == 1) { idn = 1 }
    if (util.str_contains(tk, "e") == 1) { idn = 1 }
    if (util.str_contains(tk, "E") == 1) { idn = 1 }
    vn = 0
    if (idn == 1) { vn = util.StringChangeDouble(tk) }
    else { vn = util.StringChangeInt(tk) }
    ret {"v": {"t": "num", "v": vn, "s": tk}, "pos": jn}
}
func _lit(t_lt <- string, i_lt <- int) -> dict {
    w4l = util.str_substring(t_lt, i_lt, i_lt + 4)
    w5l = util.str_substring(t_lt, i_lt, i_lt + 5)
    if (w4l == "true") { ret {"v": {"t": "bool", "v": 1}, "pos": i_lt + 4} }
    if (w5l == "false") { ret {"v": {"t": "bool", "v": 0}, "pos": i_lt + 5} }
    if (w4l == "null") { ret {"v": {"t": "null", "v": 0}, "pos": i_lt + 4} }
    error("fjson: bad literal")
}
func _val(t_v <- string, i_v <- int) -> dict {
    i_v = fjson._skip_ws(t_v, i_v)
    cv = util.str_substring(t_v, i_v, i_v + 1)
    if (cv == "{") { ret fjson._obj(t_v, i_v, 1, {"k": []}, {}) }
    if (cv == "[") { ret fjson._arr(t_v, i_v, 1, {"k": []}) }
    if (cv == "\"") { ret fjson._string(t_v, i_v) }
    if (cv == "t") { ret fjson._lit(t_v, i_v) }
    if (cv == "f") { ret fjson._lit(t_v, i_v) }
    if (cv == "n") { ret fjson._lit(t_v, i_v) }
    if (cv == "-") { ret fjson._number(t_v, i_v) }
    if (cv == "0") { ret fjson._number(t_v, i_v) }
    if (cv == "1") { ret fjson._number(t_v, i_v) }
    if (cv == "2") { ret fjson._number(t_v, i_v) }
    if (cv == "3") { ret fjson._number(t_v, i_v) }
    if (cv == "4") { ret fjson._number(t_v, i_v) }
    if (cv == "5") { ret fjson._number(t_v, i_v) }
    if (cv == "6") { ret fjson._number(t_v, i_v) }
    if (cv == "7") { ret fjson._number(t_v, i_v) }
    if (cv == "8") { ret fjson._number(t_v, i_v) }
    if (cv == "9") { ret fjson._number(t_v, i_v) }
    error("fjson: unexpected character")
}
func _obj(t_o <- string, i_o <- int, sb_o <- int, ks_o <- dict, vl_o <- dict) -> dict {
    jo = i_o
    if (sb_o == 1) { jo = jo + 1 }
    jo = fjson._skip_ws(t_o, jo)
    if (util.str_substring(t_o, jo, jo + 1) == "}") {
        ret {"v": {"t": "obj", "v": {"keys": ks_o["k"], "vals": vl_o}}, "pos": jo + 1}
    }
    if (util.str_substring(t_o, jo, jo + 1) != "\"") { error("fjson: object key must be a string") }
    krs = fjson._string(t_o, jo)
    ko = krs["v"]["v"]
    ke = ks_o["k"]
    ke = util.arr_append(ke, ko)
    ks_o = {"k": ke}
    jo = fjson._skip_ws(t_o, krs["pos"])
    if (util.str_substring(t_o, jo, jo + 1) != ":") { error("fjson: missing colon") }
    vrs = fjson._val(t_o, jo + 1)
    nkn = util.arr_length(ks_o["k"])
    ko = ks_o["k"][nkn - 1]
    vl_o[ko] = vrs["v"]
    jo = fjson._skip_ws(t_o, vrs["pos"])
    co = util.str_substring(t_o, jo, jo + 1)
    if (co == ",") {
        ret fjson._obj(t_o, jo + 1, 0, ks_o, vl_o)
    }
    if (co == "}") {
        ret {"v": {"t": "obj", "v": {"keys": ks_o["k"], "vals": vl_o}}, "pos": jo + 1}
    }
    error("fjson: bad object syntax")
}
func _arr(t_a <- string, i_a <- int, sb_a <- int, it_a <- dict) -> dict {
    ja = i_a
    if (sb_a == 1) { ja = ja + 1 }
    ja = fjson._skip_ws(t_a, ja)
    if (util.str_substring(t_a, ja, ja + 1) == "]") {
        ret {"v": {"t": "arr", "v": it_a["k"]}, "pos": ja + 1}
    }
    vra = fjson._val(t_a, ja)
    its = it_a["k"]
    its = util.arr_append(its, vra["v"])
    it_a = {"k": its}
    ja = fjson._skip_ws(t_a, vra["pos"])
    ca = util.str_substring(t_a, ja, ja + 1)
    if (ca == ",") {
        ret fjson._arr(t_a, ja + 1, 0, it_a)
    }
    if (ca == "]") {
        ret {"v": {"t": "arr", "v": it_a["k"]}, "pos": ja + 1}
    }
    error("fjson: bad array syntax")
}
func parse(t_p <- string) -> dict {
    rsp = fjson._val(t_p, 0)
    pso = fjson._skip_ws(t_p, rsp["pos"])
    if (pso != util.str_length(t_p)) { error("fjson: trailing content after JSON value") }
    ret rsp["v"]
}
