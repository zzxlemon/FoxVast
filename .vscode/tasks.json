{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "CMake: 配置",
			"command": "cmake",
			"args": [
				"-S",
				"${workspaceFolder}/FoxCore",
				"-B",
				"${workspaceFolder}/cmake-build",
				"-G",
				"MinGW Makefiles",
				"-DCMAKE_BUILD_TYPE=Release",
				"-DCMAKE_CXX_COMPILER=D:/mingw64/bin/g++.exe",
				"-DCMAKE_MAKE_PROGRAM=D:/mingw64/bin/mingw32-make.exe"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "CMake: 构建",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}/cmake-build"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$gcc"
			],
			"dependsOn": "CMake: 配置"
		}
	]
}
