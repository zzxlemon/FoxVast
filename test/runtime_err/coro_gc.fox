counters = {"a": 0, "b": 0}

func worker(idx <- string, base <- int) -> void {
    while (1) {
        k = counters[idx]
        counters[idx] = k + 1
        yield(k + base)
        if (counters[idx] % 10 == 0) {
            junk = {}
            junk["x"] = counters[idx]
            junk["y"] = counters[idx] * 2
        }
    }
}

func nested(idx <- int) -> int {
    ret idx + 50
}

func withcalls(idx <- int) -> void {
    q = 0
    while (q < 30) {
        v = nested(idx)
        yield(v + q)
        q = q + 1
    }
}

func main() -> void {
    counters = {"a": 0, "b": 0}
    a = co.create("worker", "a", 1000)
    b = co.create("worker", "b", 2000)
    it = 0
    while (it < 100) {
        va = co.resume(a)
        vb = co.resume(b)
        if (va != it + 1000) {
            println("A FAIL")
            exit(1)
        }
        if (vb != it + 2000) {
            println("B FAIL")
            exit(1)
        }
        it = it + 1
    }
    if (co.status(a) != "suspended" or co.status(b) != "suspended") {
        println("STATUS FAIL")
        exit(1)
    }

    c = co.create("withcalls", 7)
    it = 0
    while (it < 30) {
        v = co.resume(c)
        if (v != 57 + it) {
            println("NESTED FAIL")
            exit(1)
        }
        it = it + 1
    }
    if (co.status(c) != "suspended") {
        println("STATUS FAIL 2")
        exit(1)
    }
    co.resume(c)
    if (co.status(c) != "dead") {
        println("STATUS FAIL 3")
        exit(1)
    }
    println("CORO GC OK")
    exit(0)
}