func main() -> void {
    a = 1
    b = [1, 2, 3]
    b[1] = 99
    arr2 = [0, 0, 0, 0, 0, 0]
    j = 0
    while (j < 6) {
        if (j == 1 or j == 3) {
            arr2[j] = 7
        }
        j = j + 1
    }
    if (a == 1 and b[1] == 99 and arr2[1] == 7 and arr2[3] == 7 and arr2[0] == 0) {
        println("OK")
    }
    if (a != 1 or b[1] != 99 or arr2[1] != 7 or arr2[3] != 7 or arr2[0] != 0) {
        println("FAIL")
    }
    free_all()
}
