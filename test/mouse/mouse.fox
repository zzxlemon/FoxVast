import fox.gl.fg -> fg
import fox.std.util -> util

# Auto Clicker: presses the left mouse button repeatedly at the current
# cursor position while ON. Space or the Toggle button switches it, + / -
# speed it up / slow down, Q quits.

func main() -> void {
    font = "NotoSansSC-VariableFont_wght.ttf"
    win = fg.create_window("Auto Clicker - Q quit | SPACE toggle | +/- speed", 420, 320)
    fg.set_scale(win, 420, 320)

    on = 0
    interval = 90.0
    lastClick = 0.0
    clicks = 0

    while (1) {
        if (fg.window_should_close(win) == 1) { break }
        if (fg.key_down(win, "q") == 1) { break }
        if (fg.key_pressed(win, "space") == 1) { if (on == 0) { on = 1 } else { on = 0 } }
        if (fg.key_pressed(win, "=") == 1) { interval = interval - 20.0; if (interval < 20.0) { interval = 20.0 } }
        if (fg.key_pressed(win, "-") == 1) { interval = interval + 20.0; if (interval > 500.0) { interval = 500.0 } }

        if (fg.button(win, 40, 220, 150, 44, font, "Toggle") == 1) {
            if (on == 0) { on = 1 } else { on = 0 }
        }

        if (on == 1) {
            now = fg.time() * 1000.0
            if (now - lastClick >= interval) {
                lastClick = now
                fg.simulate_click(win, 1)
                clicks = clicks + 1
            }
        }

        fg.clear_color(0.05, 0.07, 0.11, 1.0)
        fg.clear()

        fg.draw_text(font, "AUTO CLICKER", 40, 30, 34, 1.0, 1.0, 1.0)
        state = "OFF"
        sc = 0.5
        if (on == 1) { state = "ON"; sc = 0.4 }
        fg.draw_text(font, "state: " + state + "  interval: " + util.DoubleChangeString(interval) + "ms", 40, 90, 22, sc, 0.9, 0.5)
        fg.draw_text(font, "clicks sent: " + util.IntChangeString(clicks), 40, 130, 22, 0.6, 0.8, 1.0)
        fg.draw_text(font, "hold nothing - clicks go where the cursor is", 40, 165, 18, 0.6, 0.6, 0.7)
        fg.draw_text(font, "SPACE toggle   + / - speed   Q quit", 40, 275, 18, 0.6, 0.6, 0.7)

        fg.update(win)
    }

    fg.close()
    println("auto clicker done - clicks " + util.IntChangeString(clicks))
}