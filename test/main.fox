import fox.gl.fg

func main() -> void{
    a = fg.create_window("Hello FoxLang", 400, 400)

    fg.clear_color(0.1, 0.2, 0.3, 1.0)

    while (!fg.window_should_close(a)){
        fg.clear_color(0.1, 0.2, 0.3, 1.0)
        fg.clear()

        fg.begin()
        fg.draw_triangle(0.0, 0.5, 1.0, 0.0, 0.0, -0.5, -0.5, 0.0, 1.0, 0.0, 0.5, -0.5, 0.0, 0.0, 1.0); # 15 var
        fg.end()

        fg.update(a)


    }

    fg.close()
    exit(0)
} 