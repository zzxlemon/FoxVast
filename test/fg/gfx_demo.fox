# gfx_demo.fox - fox.gl.fg 图形库演示
# 运行:fox -f gfx_demo.fox(需 fox.graphics.dll 与字体,见 draw_text 搜索路径)
# 操作:方向键移动方块,空格/ESC,P 打印按键事件,
#       滚轮缩放圆,按住左键画圆点,窗口可拖拽缩放,600 帧后自动退出
import fox.gl.fg -> fg
import fox.std.util -> util

func main() -> void {
    win = fg.create_window("FoxVast FG Demo", 800, 600)
    fg.set_scale(win, 800, 600)

    squareX = 380
    squareY = 280
    circleR = 70
    frame = 0
    spaced = 0

    # textures: load once, draw many times (cached by file path)
    tex = fg.load_texture(win, "..\\..\\test\\fg\\dot.png")
    texS = fg.image_size(win, tex)
    angle = 0.0

    while (1) {
        if (fg.window_should_close(win) == 1) { break }
        if (fg.key_down(win, "escape") == 1) { break }
        if (fg.key_down(win, "up") == 1) { squareY = squareY - 4 }
        if (fg.key_down(win, "down") == 1) { squareY = squareY + 4 }
        if (fg.key_down(win, "left") == 1) { squareX = squareX - 4 }
        if (fg.key_down(win, "right") == 1) { squareX = squareX + 4 }

        # edge-triggered keys: reported once per physical press/release
        if (fg.key_pressed(win, "space") == 1) { spaced = 1 }
        if (fg.key_pressed(win, "p") == 1) { println("key_pressed: p") }
        if (fg.key_released(win, "p") == 1) { println("key_released: p") }

        # wheel zooms the circle (consumes accumulated scroll)
        wheel = fg.mouse_wheel(win)
        if (wheel != 0.0) { circleR = circleR + int(wheel * 5) }

        # rotating star: angle spins with frame time (game logic demo)
        angle = angle + fg.frame_time(win) * 90.0

        fg.clear_color(0.10, 0.10, 0.16, 1.0)
        fg.clear()

        # triangle: x,y,r,g,b per vertex
        fg.draw_triangle(80, 60, 1.0, 0.2, 0.2, 240, 60, 0.2, 1.0, 0.2, 160, 200, 0.2, 0.4, 1.0)

        # rect: 4 vertex arrays [x,y,r,g,b], order TL, TR, BR, BL
        fg.draw_rect([420, 60, 0.9, 0.8, 0.2], [640, 60, 0.9, 0.8, 0.2], [640, 140, 0.4, 0.9, 0.6], [420, 140, 0.4, 0.9, 0.6])

        # line: x1,y1,x2,y2,thickness,r,g,b
        fg.draw_line(60, 300, 320, 380, 5.0, 1.0, 0.5, 0.1)

        # circle: cx,cy,radius,r,g,b (radius follows the wheel)
        fg.draw_circle(600, 320, circleR, 0.3, 0.8, 0.9)

        # textures: plain / rotated around center / tinted with alpha
        fg.draw_image(win, tex, 60, 60, 64, 64)
        fg.draw_image_rotated(win, tex, 300, 240, 64, 64, angle)
        fg.draw_image_tinted(win, tex, 460, 60, 64, 64, 1.0, 0.4, 0.4, 0.6)

        # keyboard-controlled square
        fg.draw_rect([squareX, squareY, 1.0, 0.2, 0.8], [squareX + 40, squareY, 1.0, 0.2, 0.8], [squareX + 40, squareY + 40, 1.0, 0.2, 0.8], [squareX, squareY + 40, 1.0, 0.2, 0.8])

        # text: font_file, text, x, y, size, r, g, b (ASCII chars only)
        fg.draw_text("NotoSansSC-VariableFont_wght.ttf", "FG - arrows:square space:p wheel:circle", 20, 20, 22, 1.0, 1.0, 1.0)

        # live stats: frame time, window size (follows resize), mouse pos
        dt = fg.frame_time(win)
        winS = fg.window_size(win)
        pos = fg.mouse_pos(win)
        fg.draw_text("NotoSansSC-VariableFont_wght.ttf", "frame " + util.IntChangeString(frame) + "  dt " + util.DoubleChangeString(dt) + "s", 20, 560, 18, 0.7, 0.9, 1.0)
        fg.draw_text("NotoSansSC-VariableFont_wght.ttf", "size " + util.IntChangeString(winS[0]) + "x" + util.IntChangeString(winS[1]) + "  mouse " + util.IntChangeString(pos[0]) + "," + util.IntChangeString(pos[1]), 20, 580, 16, 0.6, 0.7, 0.8)
        fg.draw_text("NotoSansSC-VariableFont_wght.ttf", "tex " + util.IntChangeString(texS[0]) + "x" + util.IntChangeString(texS[1]), 20, 42, 16, 0.8, 0.9, 0.6)
        if (spaced == 1) {
            fg.draw_text("NotoSansSC-VariableFont_wght.ttf", "SPACE pressed!", 20, 520, 20, 1.0, 0.9, 0.2)
        }

        # mouse: left button paints
        if (fg.mouse_down(win, 0) == 1) {
            fg.draw_circle(pos[0], pos[1], 12, 1.0, 0.9, 0.2)
        }

        fg.update(win)
        frame = frame + 1
        # if (frame >= 600) { break }
    }

    fg.close()
    println("gfx demo done: " + util.IntChangeString(frame) + " frames")
}